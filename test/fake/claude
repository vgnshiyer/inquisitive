#!/usr/bin/env node
// A stand-in for Claude Code, for testing: it answers as the real one prints, and touches no account.
const fs = require('node:fs');
const path = require('node:path');
const STATE = process.env.INQUISITIVE_TEST_STATE || __dirname; // where it notes down how it was run, and reads whether it is signed in
const stateFile = path.join(STATE, 'state.json');
const state = (() => { try { return JSON.parse(fs.readFileSync(stateFile, 'utf8')); } catch { return {}; } })();
const args = process.argv.slice(2);
const log = (entry) => fs.appendFileSync(path.join(STATE, 'calls.jsonl'), JSON.stringify(entry) + '\n');
const wait = (ms) => new Promise((r) => setTimeout(r, ms));
(async () => {
  if (args[0] === '--version') return console.log('2.1.300 (Claude Code)');
  if (args[0] === 'auth' && args[1] === 'status') return console.log(JSON.stringify({ loggedIn: Boolean(state.signedIn) }));
  if (args[0] === 'auth' && args[1] === 'login') {
    log({ login: true });
    await wait(state.loginMs ?? 300);
    if (state.loginFails) { console.error('Error: Login was cancelled in the browser.'); process.exit(1); }
    fs.writeFileSync(stateFile, JSON.stringify({ ...state, signedIn: true }));
    return console.log('Login successful.');
  }
  if (args[0] === '-p') {
    let prompt = '';
    for await (const chunk of process.stdin) prompt += chunk;
    log({ args, prompt, cwd: process.cwd() });
    if (!state.signedIn) { console.log(JSON.stringify({ type: 'result', is_error: true, result: 'Not logged in · Please run /login' })); process.exit(1); }
    const last = prompt.split('\n').at(-1);
    const words = prompt.includes('SLOW') ? Array.from({ length: 30 }, (_, i) => 'c' + i + ' ') : prompt.includes('single word: ready') ? ['ready'] : ['From ', 'Claude Code: ', last];
    console.log(JSON.stringify({ type: 'system', subtype: 'init' }));
    for (const w of words) { console.log(JSON.stringify({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'text_delta', text: w } } })); await wait(prompt.includes('SLOW') ? 120 : 15); }
    return console.log(JSON.stringify({ type: 'result', subtype: 'success', is_error: false, result: words.join('') }));
  }
  console.error('unknown'); process.exit(2);
})();
